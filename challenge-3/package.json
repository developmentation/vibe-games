{
  "name": "vibe-games-challenge-3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Challenge 3 deploy unit (K-12 personalized learning). Render.com web service. See PROMPT.md.",
  "main": "server-1/index.js",
  "scripts": {
    "start": "node server-1/index.js",
    "dev": "nodemon --watch server-1 --watch ../lib --ext js,mjs,sql,json server-1/index.js",
    "dev:all": "concurrently --kill-others-on-fail --names server,sql -c blue,magenta \"nodemon --watch server-1 --watch ../lib --ext js,mjs,json server-1/index.js\" \"node server-1/scripts/migrate-on-change.mjs\"",
    "migrate": "node server-1/scripts/migrate.mjs",
    "probe:curriculum": "node scripts/probe-curriculum.mjs",
    "probe:db": "node scripts/probe-challenge3.mjs",
    "probe:schema": "node scripts/probe-schema.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "google-auth-library": "^9.14.1",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.7",
    "openai": "^4.73.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  }
}
